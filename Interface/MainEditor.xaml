<UserControl x:Class="Interface.MainEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:res="clr-namespace:Interface.Resources"
             xmlns:task="clr-namespace:Interface.Task"
             xmlns:sheet="clr-namespace:Interface.Sheet"
             xmlns:export="clr-namespace:Interface.Export"
             xmlns:about="clr-namespace:Interface.About"
             xmlns:solve="clr-namespace:Interface.Solve"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <TabControl Margin="2" Padding="3">
        <TabItem Header="{x:Static res:Lang.MenuTabs_Tasks}">
            <task:TaskPage x:Name="TaskPage"/>
        </TabItem>
        <TabItem Header="{x:Static res:Lang.MenuTabs_Sheets}">
            <sheet:SheetPage/>
        </TabItem>
        <TabItem Header="{x:Static res:Lang.MenuTabs_Export}">
            <export:ExportPage/>
        </TabItem>
        <TabItem Header="{x:Static res:Lang.MenuTabs_Correct}">
            <solve:SolvePage/>
        </TabItem>
        <TabItem Header="{x:Static res:Lang.MenuTabs_About}">
            <about:About/>
        </TabItem>
    </TabControl>
</UserControl>
