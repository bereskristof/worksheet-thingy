<UserControl x:Class="Interface.MainEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:res="clr-namespace:Interface.Resources"
             xmlns:task="clr-namespace:Interface.Task"
             xmlns:sheet="clr-namespace:Interface.Sheet"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <TabControl Margin="2" Padding="3">
        <TabItem Header="{x:Static res:Lang.MenuTabs_Tasks}">
            <task:TaskPage x:Name="TaskPage"/>
        </TabItem>
        <TabItem Header="Sheets">
            <sheet:SheetPage/>
        </TabItem>
        <TabItem Header="Export" IsEnabled="False"/>
        <TabItem Header="Correct" IsEnabled="False"/>
        <TabItem Header="Debug">
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" Content="Generate lists" Click="ButtonBase_OnClick"/>
        </TabItem>
    </TabControl>
</UserControl>
